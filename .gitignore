vendor/
.env
.phpunit.cache/
/phpunit*.xml
/builds

# keep the writable/ skeleton, ignore its runtime contents
writable/**/*
!writable/
!writable/**/
!writable/**/.gitkeep
!writable/**/index.html
!writable/**/.htaccess

# user-uploaded profile photos (runtime data) - keep the folder, not the files
public/assets/avatars/*
!public/assets/avatars/
!public/assets/avatars/index.html
