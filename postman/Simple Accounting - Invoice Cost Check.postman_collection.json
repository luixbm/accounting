{
  "info": {
    "name": "Simple Accounting - Invoice Cost Check",
    "description": "Budget -> actual supplier-cost matching flow (the n8n supplier-invoice pipeline). Mirrors docs/API.md and docs/n8n-supplier-invoice.md.\n\nSet the collection variables `base_url` and `token` before running:\n- base_url: e.g. http://localhost:8080/api/v1 (LAN: http://<server-ip>:8080/api/v1)\n- token: create one in the app under Setup -> API Tokens, abilities `read` + `purchase:write`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080/api/v1", "type": "string" },
    { "key": "token", "value": "REPLACE_WITH_YOUR_API_TOKEN", "type": "string" },
    { "key": "supplier", "value": "Happy Trails Indonesia", "type": "string" },
    { "key": "from", "value": "2026-05-01", "type": "string" },
    { "key": "to", "value": "2026-05-10", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Ping (check token + company)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ping",
              "host": [ "{{base_url}}" ],
              "path": [ "ping" ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Lookups",
      "item": [
        {
          "name": "GET Accounts (find cost account codes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/accounts?type=expense",
              "host": [ "{{base_url}}" ],
              "path": [ "accounts" ],
              "query": [ { "key": "type", "value": "expense" } ]
            }
          },
          "response": []
        },
        {
          "name": "GET Suppliers (find supplier code/name)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/suppliers?q={{supplier}}",
              "host": [ "{{base_url}}" ],
              "path": [ "suppliers" ],
              "query": [ { "key": "q", "value": "{{supplier}}" } ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Invoice check flow",
      "description": "The core loop: find what's still on a budget figure, propose actual costs as a dry run to see match + variance, then apply.",
      "item": [
        {
          "name": "1) GET pending budget lines (for one supplier + date window)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/purchase/lines/pending?supplier={{supplier}}&from={{from}}&to={{to}}&limit=200",
              "host": [ "{{base_url}}" ],
              "path": [ "purchase", "lines", "pending" ],
              "query": [
                { "key": "supplier", "value": "{{supplier}}" },
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" },
                { "key": "limit", "value": "200" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "2) POST costs - DRY RUN (see match + variance, writes nothing)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dry_run\": true,\n  \"window_days\": 5,\n  \"costs\": [\n    {\n      \"booking_ref\": \"26348-5717003\",\n      \"cost\": 16500000,\n      \"supplier_invoice_ref\": \"HTI-TEST-0001\",\n      \"supplier_invoice_date\": \"2026-05-06\"\n    },\n    {\n      \"booking_ref\": \"26537-5737441\",\n      \"cost\": 400000,\n      \"supplier_invoice_ref\": \"HTI-TEST-0002\",\n      \"supplier_invoice_date\": \"2026-05-01\",\n      \"remark\": \"Postman dry-run test\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/purchase/lines/costs",
              "host": [ "{{base_url}}" ],
              "path": [ "purchase", "lines", "costs" ]
            }
          },
          "response": []
        },
        {
          "name": "3) POST costs - APPLY (writes the actual, re-posts affected invoices)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"window_days\": 5,\n  \"costs\": [\n    {\n      \"booking_ref\": \"29593-6096761\",\n      \"cost\": 2100000,\n      \"supplier_invoice_ref\": \"PURI-8841\",\n      \"supplier_invoice_date\": \"2026-05-03\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/purchase/lines/costs",
              "host": [ "{{base_url}}" ],
              "path": [ "purchase", "lines", "costs" ]
            }
          },
          "response": []
        },
        {
          "name": "4) POST review - queue a batch for the Invoice Review page (writes nothing to invoices)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"n8n\",\n  \"file_name\": \"weekly-recap.pdf\",\n  \"vendor\": \"{{supplier}}\",\n  \"window_days\": 5,\n  \"items\": [\n    {\n      \"booking_ref\": \"26537-5737441\",\n      \"cost\": 400000,\n      \"party_name\": \"Saponaro\",\n      \"description\": \"Guide Fee Bali - Fullday (Dutch Speaking)\",\n      \"supplier_invoice_ref\": \"HTI-REVIEW-TEST\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/purchase/lines/review",
              "host": [ "{{base_url}}" ],
              "path": [ "purchase", "lines", "review" ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
