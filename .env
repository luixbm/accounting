#--------------------------------------------------------------------
# Production .env  —  copy to ".env" on the server and fill every ***.
# Never commit the real .env (it is git-ignored).
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://dev.happylocaladventure.com/'
app.indexPage = ''
app.forceGlobalSecureRequests = true       # redirect http -> https

# CSRF protection — ON in production. Every POST form emits csrf_field();
# the token-authed /api/* routes are excluded automatically.
app.csrfProtection = true

#--------------------------------------------------------------------
# DATABASE   (create the DB + user in cPanel / on the server first)
#--------------------------------------------------------------------

database.default.hostname = dev.happylocaladventure.com
database.default.database = happyloc_simple_accounting
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# ENCRYPTION
#   Generate a fresh key ON THE SERVER:  php spark key:generate
#   (do NOT reuse the development key)
#--------------------------------------------------------------------

encryption.key =

#--------------------------------------------------------------------
# LOGGING  (quieter in production)
#--------------------------------------------------------------------

logger.threshold = 4
